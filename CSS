body {
    font-family: Arial, sans-serif;
    text-align: center;
    background-color: #109141;
    color: white;
}

#contenedor {
    display: flex;
    justify-content: center;
    gap: 50px;
    margin: 30px;
}

.jugador img {
    width: 250px;
    height: 250px;
    object-fit: cover;
    border-radius: 10px;
    border: 3px solid white;
}

button {
    background-color: white;
    color: #109141;
    border: none;
    padding: 10px 20px;
    font-size: 16px;
    cursor: pointer;
    border-radius: 8px;
}

button:hover {
    background-color: #109141;
    color: white;
}
